+void spiWriteReg(const extDevice_t *, uint8_t, uint8_t) {}
+void spiWriteRegBuf(const extDevice_t *, uint8_t, uint8_t *, uint32_t) {}
+
+bool spiReadRegMskBufRB(const extDevice_t *, uint8_t reg, uint8_t *data, uint8_t length)
+{
+    lastReadReg = reg;
+    lastReadLength = length;
+    if (!readOk || length != 2) {
+        return false;
+    }
+    data[0] = mockedTemp[0];
+    data[1] = mockedTemp[1];
+    return true;
+}
