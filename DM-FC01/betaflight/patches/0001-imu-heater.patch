+// 手册 5.3.7：11 位补码，MSB 为 [10:3]，LSB 的 [7:5] 为 [2:0]；0.125 °C/LSB，零点 23 °C
+STATIC_UNIT_TESTED int16_t bmi088TemperatureCenti(uint8_t msb, uint8_t lsb)
+{
+    int16_t raw = (int16_t)(((uint16_t)msb << 3) | (lsb >> 5));
+    if (raw > 1023) {
+        raw -= 2048;
+    }
+    return (int16_t)(2300 + (raw * 25) / 2);
+}
+
 uint8_t bmi088GyroDetect(const extDevice_t *dev)
 {
     return spiReadRegMsk(dev, BMI088_GYRO_REG_CHIP_ID) == BMI088_GYRO_CHIP_ID ? BMI_088_SPI : MPU_NONE;
@@ -198,11 +209,66 @@ static bool bmi088GyroRead(gyroDev_t *gyro)
     return true;
 }
 
+// 温度传感器在加速度计 die 上。BMI088 不是当前加计时 Betaflight 不会初始化这颗 die，
+// 所以单独建一个设备把它唤醒，给加热器等用途读温度。若之后它被选为加计，
+// bmi088AccInit 会软复位并重新使能，温度读数不受影响。
+static extDevice_t bmi088TempDev[GYRO_COUNT];
+
+static bool bmi088ReadTemperature(gyroDev_t *gyro, int16_t *temperature)
+{
+    const extDevice_t *dev = &bmi088TempDev[gyro->deviceIndex];
+    if (spiIsBusy(dev)) {
+        return false;
+    }
+
+    // 加计读操作在寄存器地址后插一个哑字节
+    uint8_t raw[3];
+    spiReadRegBuf(dev, BMI088_ACC_REG_TEMP_MSB | BMI088_SPI_READ, raw, sizeof(raw));
+    gyro->temperatureCenti = bmi088TemperatureCenti(raw[1], raw[2]);
+    *temperature = gyro->temperatureCenti / 100;
+    return true;
+}
+
+static void bmi088TempInit(gyroDev_t *gyro)
+{
+    if (!gyro->accCsnTag || gyro->deviceIndex >= GYRO_COUNT) {
+        return;
+    }
+
+    extDevice_t *dev = &bmi088TempDev[gyro->deviceIndex];
+    if (!spiSetBusInstance(dev, gyro->spiBus)) {
+        return;
+    }
+
+    dev->busType_u.spi.csnPin = IOGetByTag(gyro->accCsnTag);
+    IOInit(dev->busType_u.spi.csnPin, OWNER_ACC_CS, RESOURCE_INDEX(gyro->deviceIndex));
+    IOConfigGPIO(dev->busType_u.spi.csnPin, SPI_IO_CS_CFG);
+    IOHi(dev->busType_u.spi.csnPin);
+    spiSetClkDivisor(dev, spiCalculateDivider(BMI088_DETECT_SPI_CLK_HZ));
+
+    (void)bmi088AccReadReg(dev, BMI088_ACC_REG_CHIP_ID);
+    delay(1);
+    if (bmi088AccReadReg(dev, BMI088_ACC_REG_CHIP_ID) != BMI088_ACC_CHIP_ID) {
+        return;
+    }
+
+    // 上电默认 suspend，温度只在 active 下每 1.28 s 更新
+    spiWriteReg(dev, BMI088_ACC_REG_PWR_CONF, BMI088_ACC_PWR_ACTIVE);
+    delay(1);
+    spiWriteReg(dev, BMI088_ACC_REG_PWR_CTRL, BMI088_ACC_PWR_ENABLE);
+    delay(1);
+    spiSetClkDivisor(dev, spiCalculateDivider(BMI088_MAX_SPI_CLK_HZ));
+
+    busDeviceRegister(dev);
+    gyro->temperatureFn = bmi088ReadTemperature;
+}
+
 static void bmi088GyroInit(gyroDev_t *gyro)
 {
     bmi088GyroConfig(gyro);
     bmi088GyroExtiInit(gyro);
     spiSetClkDivisor(&gyro->dev, spiCalculateDivider(BMI088_MAX_SPI_CLK_HZ));
+    bmi088TempInit(gyro);
 }
 
 bool bmi088SpiGyroDetect(gyroDev_t *gyro)
