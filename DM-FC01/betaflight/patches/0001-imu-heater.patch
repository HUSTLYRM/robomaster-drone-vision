+ * If not, see <http://www.gnu.org/licenses/>.
+ */
+
+/*
+ * IMU 恒温加热：每路加热器按对应陀螺的芯片温度做 PI 闭环，GPIO 软件 PWM 输出（周期 100 ms）。
+ * 控制律同 PX4 heater 驱动（前馈 + 比例 + 限幅积分），另加积分抗饱和。
+ * 读数无效、连续读失败或超温时立即关断并清积分。
+ */
+
+#include <math.h>
+#include <stdbool.h>
+#include <stdint.h>
+#include <string.h>
+
+#include "platform.h"
+
+#ifdef USE_IMU_HEATER
+
+#include "build/debug.h"
+
+#include "common/maths.h"
+#include "common/utils.h"
+
+#include "drivers/io.h"
+#include "drivers/resource.h"
+
+#include "pg/pg_ids.h"
+
+#include "sensors/gyro.h"
+
+#include "imu_heater.h"
+
+#ifndef IMU_HEATER_1_PIN
+#define IMU_HEATER_1_PIN NONE
+#endif
+#ifndef IMU_HEATER_2_PIN
+#define IMU_HEATER_2_PIN NONE
+#endif
+
+#ifndef DEFAULT_IMU_HEATER_TARGET
+#define DEFAULT_IMU_HEATER_TARGET 0
+#endif
+
+#ifndef DEFAULT_IMU_HEATER_1_P
+#define DEFAULT_IMU_HEATER_1_P 65
+#endif
+#ifndef DEFAULT_IMU_HEATER_1_I
+#define DEFAULT_IMU_HEATER_1_I 100
+#endif
+#ifndef DEFAULT_IMU_HEATER_1_FF
+#define DEFAULT_IMU_HEATER_1_FF 2
+#endif
+#ifndef DEFAULT_IMU_HEATER_2_P
+#define DEFAULT_IMU_HEATER_2_P 65
+#endif
+#ifndef DEFAULT_IMU_HEATER_2_I
+#define DEFAULT_IMU_HEATER_2_I 100
+#endif
+#ifndef DEFAULT_IMU_HEATER_2_FF
+#define DEFAULT_IMU_HEATER_2_FF 2
+#endif
+
+#define IMU_HEATER_TEMP_MIN_C           -40.0f  // 读数超出此范围视为无效
+#define IMU_HEATER_TEMP_MAX_C           80.0f
+#define IMU_HEATER_OVERTEMP_MARGIN_C    10.0f   // 高于目标这么多直接关断
+#define IMU_HEATER_INTEGRATOR_LIMIT     0.25f   // 与 PX4 一致
+#define IMU_HEATER_FAIL_LIMIT           10      // 连续读失败次数（控制周期 0.1 s，约 1 s）
+#define IMU_HEATER_CONTROL_PERIOD_US    100000
+// 加热器满功率升温 >2 °C/s（实测），PWM 周期须远短于热响应，否则单个开周期就会过冲
+#define IMU_HEATER_PWM_PERIOD_US        100000  // 任务 1 kHz 运行，占空比分辨率 1%
+#define IMU_HEATER_MAX_DT_US            1000000
+
+typedef struct imuHeaterGains_s {
+    float kp;   // 占空比/°C
+    float ki;   // 占空比/(°C·s)
+    float ff;   // 占空比
+} imuHeaterGains_t;
+
+typedef struct imuHeater_s {
+    IO_t io;
+    float integrator;
+    float duty;
+    int16_t temperatureCenti;
+    uint8_t failCount;
+} imuHeater_t;
+
+static imuHeater_t heaters[IMU_HEATER_COUNT];
+static bool heaterEnabled;
+static timeUs_t lastControlUs;
+static bool controlStarted;
+
+PG_REGISTER_WITH_RESET_FN(imuHeaterConfig_t, imuHeaterConfig, PG_IMU_HEATER_CONFIG, 0);
+
+void pgResetFn_imuHeaterConfig(imuHeaterConfig_t *config)
+{
+    config->ioTag[0] = IO_TAG(IMU_HEATER_1_PIN);
+    config->ioTag[1] = IO_TAG(IMU_HEATER_2_PIN);
+    config->targetTemp = DEFAULT_IMU_HEATER_TARGET;
+    config->kp[0] = DEFAULT_IMU_HEATER_1_P;
+    config->ki[0] = DEFAULT_IMU_HEATER_1_I;
+    config->ff[0] = DEFAULT_IMU_HEATER_1_FF;
+    config->kp[1] = DEFAULT_IMU_HEATER_2_P;
+    config->ki[1] = DEFAULT_IMU_HEATER_2_I;
+    config->ff[1] = DEFAULT_IMU_HEATER_2_FF;
+}
+
+// 返回 0..1 的占空比；dtS 为距上次调用的秒数，首次调用传 0
+STATIC_UNIT_TESTED float imuHeaterControl(float *integrator, const imuHeaterGains_t *gains,
+                                          float targetC, bool tempValid, float tempC, float dtS)
+{
+    if (targetC <= 0.0f || !tempValid
+        || tempC < IMU_HEATER_TEMP_MIN_C || tempC > IMU_HEATER_TEMP_MAX_C
+        || tempC >= targetC + IMU_HEATER_OVERTEMP_MARGIN_C) {
+        *integrator = 0.0f;
+        return 0.0f;
+    }
+
+    const float error = targetC - tempC;
+    const float unclamped = gains->ff + gains->kp * error + *integrator;
+
+    // 输出已饱和且误差仍推向饱和方向时不再积分，避免升温段积满后过冲
+    const bool saturatedHigh = unclamped >= 1.0f && error > 0.0f;
+    const bool saturatedLow = unclamped <= 0.0f && error < 0.0f;
+    if (!saturatedHigh && !saturatedLow) {
+        *integrator = constrainf(*integrator + gains->ki * error * dtS,
+                                 -IMU_HEATER_INTEGRATOR_LIMIT, IMU_HEATER_INTEGRATOR_LIMIT);
+    }
+
+    return constrainf(gains->ff + gains->kp * error + *integrator, 0.0f, 1.0f);
+}
+
+// 软件 PWM：周期 100 ms，前 duty 部分为开
+STATIC_UNIT_TESTED bool imuHeaterPwmState(float duty, timeUs_t nowUs)
+{
+    // 先把开时间取整到微秒再比较，避免浮点误差让边界抖动
+    return (int32_t)(nowUs % IMU_HEATER_PWM_PERIOD_US) < lrintf(duty * IMU_HEATER_PWM_PERIOD_US);
+}
+
+void imuHeaterInit(void)
+{
+    memset(heaters, 0, sizeof(heaters));
+    heaterEnabled = false;
+    controlStarted = false;
+
+    for (int i = 0; i < IMU_HEATER_COUNT; i++) {
+        imuHeater_t *heater = &heaters[i];
+        heater->io = IOGetByTag(imuHeaterConfig()->ioTag[i]);
+        if (!heater->io) {
+            continue;
+        }
+
+        IOInit(heater->io, OWNER_IMU_HEATER, RESOURCE_INDEX(i));
+        IOConfigGPIO(heater->io, IOCFG_OUT_PP);
+        IOLo(heater->io);
+        heater->failCount = IMU_HEATER_FAIL_LIMIT;  // 拿到第一个有效读数之前不加热
+        heaterEnabled = true;
+    }
+}
+
+bool imuHeaterIsEnabled(void)
+{
+    return heaterEnabled;
+}
+
+static void imuHeaterControlStep(float dtS)
+{
+    const imuHeaterConfig_t *config = imuHeaterConfig();
+    const float targetC = MIN(config->targetTemp, IMU_HEATER_TARGET_MAX);
+
+    for (int i = 0; i < IMU_HEATER_COUNT; i++) {
+        imuHeater_t *heater = &heaters[i];
+        if (!heater->io) {
+            continue;
+        }
+
+        int16_t temperatureCenti;
+        if (gyroReadSensorTemperatureCenti(i, &temperatureCenti)) {
+            heater->temperatureCenti = temperatureCenti;
+            heater->failCount = 0;
+        } else if (heater->failCount < IMU_HEATER_FAIL_LIMIT) {
+            heater->failCount++;
+        }
+
+        const imuHeaterGains_t gains = {
+            .kp = config->kp[i] / 100.0f,
+            .ki = config->ki[i] / 1000.0f,
+            .ff = config->ff[i] / 100.0f,
+        };
+        heater->duty = imuHeaterControl(&heater->integrator, &gains, targetC,
+                                        heater->failCount < IMU_HEATER_FAIL_LIMIT,
+                                        heater->temperatureCenti / 100.0f, dtS);
+
+        DEBUG_SET(DEBUG_IMU_HEATER, 2 * i, heater->temperatureCenti);  //!< [index:0,2] Heater {1|2} Temperature [unit:0.01degC]
+        DEBUG_SET(DEBUG_IMU_HEATER, 2 * i + 1, lrintf(heater->duty * 1000.0f));  //!< [index:1,3] Heater {1|2} Duty [unit:0.001]
+    }
+}
+
+void imuHeaterUpdate(timeUs_t currentTimeUs)
+{
+    const timeDelta_t sinceControlUs = cmpTimeUs(currentTimeUs, lastControlUs);
+    if (!controlStarted || sinceControlUs >= IMU_HEATER_CONTROL_PERIOD_US) {
+        // 调度长时间停顿后 dt 封顶 1 s，防止积分一次跳太多
+        const float dtS = controlStarted ? MIN(sinceControlUs, IMU_HEATER_MAX_DT_US) * 1e-6f : 0.0f;
+        lastControlUs = currentTimeUs;
+        controlStarted = true;
+        imuHeaterControlStep(dtS);
+    }
+
+    for (int i = 0; i < IMU_HEATER_COUNT; i++) {
+        if (heaters[i].io) {
+            IOWrite(heaters[i].io, imuHeaterPwmState(heaters[i].duty, currentTimeUs));
+        }
+    }
+}
+
+#endif // USE_IMU_HEATER
