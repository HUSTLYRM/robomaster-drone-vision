+++ b/src/main/drivers/accgyro/accgyro_spi_bmi088.c
@@ -42,6 +42,7 @@
 
 #define BMI088_ACC_REG_CHIP_ID            0x00
 #define BMI088_ACC_REG_DATA               0x12
+#define BMI088_ACC_REG_TEMP_MSB           0x22
 #define BMI088_ACC_REG_CONF               0x40
 #define BMI088_ACC_REG_RANGE              0x41
 #define BMI088_ACC_REG_PWR_CONF           0x7C
@@ -133,6 +134,16 @@ static bool bmi088AccReadData(const extDevice_t *dev, uint8_t data[BMI088_AXIS_D
     return true;
