+typedef struct imuHeaterGains_s {
+    float kp;
+    float ki;
+    float ff;
+} imuHeaterGains_t;
+
+STATIC_UNIT_TESTED float imuHeaterControl(float *integrator, const imuHeaterGains_t *gains,
+                                          float targetC, bool tempValid, float tempC, float dtS);
+STATIC_UNIT_TESTED bool imuHeaterPwmState(float duty, timeUs_t nowUs);
+
+int16_t debug[DEBUG16_VALUE_COUNT];
