+
+TEST(ImuHeater, PwmHundredMillisecondPeriod)
+{
+    EXPECT_FALSE(imuHeaterPwmState(0.0f, 0));
+    EXPECT_FALSE(imuHeaterPwmState(0.0f, 99999));
+    EXPECT_TRUE(imuHeaterPwmState(1.0f, 0));
+    EXPECT_TRUE(imuHeaterPwmState(1.0f, 99999));
+    EXPECT_TRUE(imuHeaterPwmState(0.3f, 29999));
+    EXPECT_FALSE(imuHeaterPwmState(0.3f, 30000));
+    EXPECT_TRUE(imuHeaterPwmState(0.3f, 1000000 + 10000));    // 跨周期回绕
+    EXPECT_FALSE(imuHeaterPwmState(0.3f, 1000000 + 70000));
+}
+
+// ---- 集成：任务更新、读失败关断、引脚输出 ----
+
+static bool tempOk[2];
+static int16_t tempCenti[2];
+static unsigned tempReads[2];
+static bool pinHigh[2];
+
+static int pinIndex(IO_t io)
+{
+    return static_cast<int>(reinterpret_cast<uintptr_t>(io)) - 1;   // ioTag 1/2 → 引脚 0/1
+}
+
+static void setupHeaters(void)
+{
+    imuHeaterConfig_t *config = imuHeaterConfigMutable();
+    config->ioTag[0] = 1;
+    config->ioTag[1] = 2;
+    config->targetTemp = 48;
+    config->kp[0] = 65;  config->ki[0] = 100; config->ff[0] = 2;
+    config->kp[1] = 20;  config->ki[1] = 0;   config->ff[1] = 4;
+    for (int i = 0; i < 2; i++) {
+        tempOk[i] = false;
+        tempCenti[i] = 0;
+        tempReads[i] = 0;
+        pinHigh[i] = true;      // 初始化必须把它拉低
+    }
+    debugMode = DEBUG_IMU_HEATER;
+    imuHeaterInit();
+}
+
+TEST(ImuHeater, InitDrivesPinsLow)
+{
+    setupHeaters();
+    EXPECT_TRUE(imuHeaterIsEnabled());
+    EXPECT_FALSE(pinHigh[0]);
+    EXPECT_FALSE(pinHigh[1]);
+}
+
+TEST(ImuHeater, NoPinsMeansDisabled)
+{
+    setupHeaters();
+    imuHeaterConfigMutable()->ioTag[0] = 0;
+    imuHeaterConfigMutable()->ioTag[1] = 0;
+    imuHeaterInit();
+    EXPECT_FALSE(imuHeaterIsEnabled());
+}
+
+TEST(ImuHeater, StaysOffUntilFirstValidReading)
+{
+    setupHeaters();
+    imuHeaterUpdate(0);
+    EXPECT_FALSE(pinHigh[0]);
+    EXPECT_FALSE(pinHigh[1]);
+    EXPECT_EQ(1u, tempReads[0]);
+
+    tempOk[0] = true;
+    tempCenti[0] = 2000;    // 20 °C，远低于目标，占空比打满
+    imuHeaterUpdate(100000);
+    EXPECT_TRUE(pinHigh[0]);
+    EXPECT_FALSE(pinHigh[1]);   // 第二路一直读不到
+    EXPECT_EQ(1000, debug[1]);
+    EXPECT_EQ(2000, debug[0]);
+}
+
+TEST(ImuHeater, ControlRunsAtTenHertz)
+{
+    setupHeaters();
+    tempOk[0] = true;
+    tempCenti[0] = 2000;
+    imuHeaterUpdate(0);
+    imuHeaterUpdate(10000);
+    imuHeaterUpdate(99999);
+    EXPECT_EQ(1u, tempReads[0]);
+    imuHeaterUpdate(100000);
+    EXPECT_EQ(2u, tempReads[0]);
+}
+
+TEST(ImuHeater, ShutsOffAfterConsecutiveReadFailures)
+{
+    setupHeaters();
+    tempOk[0] = true;
+    tempCenti[0] = 2000;
+    timeUs_t t = 0;
+    imuHeaterUpdate(t);
+    ASSERT_TRUE(pinHigh[0]);
+
+    // 偶发失败沿用上次读数，不关断
+    tempOk[0] = false;
+    for (int i = 0; i < 9; i++) {
+        t += 100000;
+        imuHeaterUpdate(t);
+        EXPECT_TRUE(pinHigh[0]) << i;
+    }
+    // 连续第 10 次失败：关断
+    t += 100000;
+    imuHeaterUpdate(t);
+    EXPECT_FALSE(pinHigh[0]);
+    EXPECT_EQ(0, debug[1]);
+
+    // 恢复读数后重新加热
+    tempOk[0] = true;
+    t += 100000;
+    imuHeaterUpdate(t);
+    EXPECT_TRUE(pinHigh[0]);
+}
+
+TEST(ImuHeater, SoftwarePwmBetweenControlSteps)
+{
+    setupHeaters();
+    imuHeaterConfigMutable()->ki[0] = 0;
+    tempOk[0] = true;
+    tempCenti[0] = 4750;    // 差 0.5 °C：0.02 + 0.65 × 0.5 = 0.345
+    imuHeaterUpdate(0);
+    EXPECT_EQ(345, debug[1]);
+    EXPECT_TRUE(pinHigh[0]);
+    imuHeaterUpdate(20000);
+    EXPECT_TRUE(pinHigh[0]);
+    imuHeaterUpdate(34000);
+    EXPECT_TRUE(pinHigh[0]);
+    imuHeaterUpdate(35000);
+    EXPECT_FALSE(pinHigh[0]);
+    imuHeaterUpdate(99000);
+    EXPECT_FALSE(pinHigh[0]);
+}
+
+TEST(ImuHeater, IntegratorStepCappedAfterSchedulerStall)
+{
+    setupHeaters();
+    imuHeaterConfigMutable()->kp[0] = 0;
+    imuHeaterConfigMutable()->ff[0] = 0;
+    imuHeaterConfigMutable()->ki[0] = 100;  // 0.1 /(°C·s)
+    tempOk[0] = true;
+    tempCenti[0] = 4700;                    // 差 1 °C
+    imuHeaterUpdate(0);
+    imuHeaterUpdate(5000000);               // 停顿 5 s，按 1 s 计：0.1 × 1 × 1
+    EXPECT_EQ(100, debug[1]);
+}
+
+extern "C" {
+
+bool gyroReadSensorTemperatureCenti(int index, int16_t *temperature)
+{
+    tempReads[index]++;
+    if (!tempOk[index]) {
+        return false;
+    }
+    *temperature = tempCenti[index];
+    return true;
+}
+
+IO_t IOGetByTag(ioTag_t tag) { return reinterpret_cast<IO_t>(static_cast<uintptr_t>(tag)); }
+void IOInit(IO_t, resourceOwner_e, uint8_t) {}
+void IOConfigGPIO(IO_t, ioConfig_t) {}
+void IOLo(IO_t io) { pinHigh[pinIndex(io)] = false; }
+void IOWrite(IO_t io, bool hi) { pinHigh[pinIndex(io)] = hi; }
+
+}
