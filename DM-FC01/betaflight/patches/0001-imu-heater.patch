+    for (int i = 0; i < 50; i++) {
+        EXPECT_FLOAT_EQ(1.0f, imuHeaterControl(&integrator, &gains, 48.0f, true, 20.0f, 0.1f));
+    }
+    EXPECT_FLOAT_EQ(0.0f, integrator);
+}
