+
+}
+
+#include "gtest/gtest.h"
+
+static const imuHeaterGains_t gains = { .kp = 0.65f, .ki = 0.1f, .ff = 0.02f };
+
+TEST(ImuHeater, OffWhenTargetIsZero)
+{
+    float integrator = 0.1f;
+    EXPECT_FLOAT_EQ(0.0f, imuHeaterControl(&integrator, &gains, 0.0f, true, 20.0f, 0.1f));
+    EXPECT_FLOAT_EQ(0.0f, integrator);
+}
+
+TEST(ImuHeater, OffAndResetWhenTemperatureInvalid)
+{
+    float integrator = 0.1f;
+    EXPECT_FLOAT_EQ(0.0f, imuHeaterControl(&integrator, &gains, 48.0f, false, 20.0f, 0.1f));
+    EXPECT_FLOAT_EQ(0.0f, integrator);
+}
+
+TEST(ImuHeater, OffWhenReadingOutsidePlausibleRange)
+{
+    float integrator = 0.0f;
+    EXPECT_FLOAT_EQ(0.0f, imuHeaterControl(&integrator, &gains, 48.0f, true, -40.5f, 0.1f));
+    EXPECT_FLOAT_EQ(0.0f, imuHeaterControl(&integrator, &gains, 48.0f, true, 80.5f, 0.1f));
+    // 边界本身仍可加热
+    EXPECT_GT(imuHeaterControl(&integrator, &gains, 48.0f, true, -40.0f, 0.0f), 0.0f);
+}
+
+TEST(ImuHeater, OffAtOvertempMargin)
+{
+    float integrator = 0.2f;
+    EXPECT_FLOAT_EQ(0.0f, imuHeaterControl(&integrator, &gains, 48.0f, true, 58.0f, 0.1f));
+    EXPECT_FLOAT_EQ(0.0f, integrator);
+}
+
+TEST(ImuHeater, ProportionalPlusFeedForward)
+{
+    float integrator = 0.0f;
+    const imuHeaterGains_t pOnly = { .kp = 0.65f, .ki = 0.0f, .ff = 0.02f };
+    EXPECT_NEAR(0.67f, imuHeaterControl(&integrator, &pOnly, 48.0f, true, 47.0f, 0.1f), 1e-6f);
+    // 高于目标：P 项为负，扣到 0 为止
+    EXPECT_FLOAT_EQ(0.0f, imuHeaterControl(&integrator, &pOnly, 48.0f, true, 49.0f, 0.1f));
+}
+
+TEST(ImuHeater, IntegratesNearTarget)
+{
+    float integrator = 0.0f;
+    imuHeaterControl(&integrator, &gains, 48.0f, true, 47.5f, 0.1f);
+    EXPECT_NEAR(0.005f, integrator, 1e-6f);
+}
+
+TEST(ImuHeater, IntegratorClampedToQuarter)
+{
+    float integrator = 0.0f;
+    const imuHeaterGains_t iOnly = { .kp = 0.0f, .ki = 1.0f, .ff = 0.0f };
+    for (int i = 0; i < 100; i++) {
+        imuHeaterControl(&integrator, &iOnly, 48.0f, true, 47.0f, 0.1f);
+    }
+    EXPECT_FLOAT_EQ(0.25f, integrator);
+
+    // 负向：前馈够大、输出始终未触底时，积分才会一路降到下限
+    const imuHeaterGains_t iWithFf = { .kp = 0.0f, .ki = 1.0f, .ff = 0.5f };
+    for (int i = 0; i < 100; i++) {
+        imuHeaterControl(&integrator, &iWithFf, 48.0f, true, 49.0f, 0.1f);
+    }
+    EXPECT_FLOAT_EQ(-0.25f, integrator);
+}
