+
+TEST(AccgyroSpiIcm456xx, ConvertsRegisterTemperature)
+{
+    // TDK 示例：25 + raw / 128 °C
+    EXPECT_EQ(2500, icm456xxTemperatureCenti(0));
+    EXPECT_EQ(4800, icm456xxTemperatureCenti(23 * 128));
+    EXPECT_EQ(2000, icm456xxTemperatureCenti(-5 * 128));
+    EXPECT_EQ(2500, icm456xxTemperatureCenti(1));        // 0.78 centi 截断
+    EXPECT_EQ(28099, icm456xxTemperatureCenti(INT16_MAX));
+    EXPECT_EQ(-23100, icm456xxTemperatureCenti(INT16_MIN));
+}
+
+TEST(AccgyroSpiIcm456xx, DetectInstallsTemperatureReader)
+{
+    gyroDev_t gyro = {};
+    gyro.mpuDetectionResult.sensor = ICM_45686_SPI;
+    ASSERT_TRUE(icm456xxSpiGyroDetect(&gyro));
+    ASSERT_NE(nullptr, gyro.temperatureFn);
+
+    // 小端：0x0C 为低字节
+    const int16_t raw = 23 * 128;
+    mockedTemp[0] = raw & 0xff;
+    mockedTemp[1] = (raw >> 8) & 0xff;
+    readOk = true;
+    int16_t degC = 0;
+    ASSERT_TRUE(gyro.temperatureFn(&gyro, &degC));
+    EXPECT_EQ(0x0c, lastReadReg);
+    EXPECT_EQ(2, lastReadLength);
+    EXPECT_EQ(4800, gyro.temperatureCenti);
+    EXPECT_EQ(48, degC);
+}
+
+TEST(AccgyroSpiIcm456xx, TemperatureReadFailureIsReported)
+{
+    gyroDev_t gyro = {};
+    gyro.mpuDetectionResult.sensor = ICM_45686_SPI;
+    ASSERT_TRUE(icm456xxSpiGyroDetect(&gyro));
+    gyro.temperatureCenti = 1234;
+
+    readOk = false;
+    int16_t degC = 0;
+    EXPECT_FALSE(gyro.temperatureFn(&gyro, &degC));
+    EXPECT_EQ(1234, gyro.temperatureCenti);
+}
