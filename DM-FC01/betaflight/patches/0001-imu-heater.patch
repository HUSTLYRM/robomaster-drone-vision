+TEST(ImuHeater, NoWindupWhileSaturatedLow)
+{
+    float integrator = 0.0f;
+    for (int i = 0; i < 50; i++) {
+        EXPECT_FLOAT_EQ(0.0f, imuHeaterControl(&integrator, &gains, 48.0f, true, 52.0f, 0.1f));
+    }
+    EXPECT_FLOAT_EQ(0.0f, integrator);
+}
+
+TEST(ImuHeater, FirstCallDoesNotIntegrate)
+{
+    float integrator = 0.0f;
+    imuHeaterControl(&integrator, &gains, 48.0f, true, 47.5f, 0.0f);
+    EXPECT_FLOAT_EQ(0.0f, integrator);
